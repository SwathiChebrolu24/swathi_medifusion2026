FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

# NOTE: PyTorch removed — all AI is handled via Google Gemini API (no local models needed)
# This reduces image size by ~800MB

# Copy & install Python requirements
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy app code
COPY ./app /app/app

CMD ["sh", "-c", "python -c 'from app.core.init_db import init; init()' && python -c 'from app.core.schema_migrations import migrate_schema; migrate_schema()' && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
